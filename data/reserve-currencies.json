  "milestones": [
    {"t": 1995, "title": "The mark leads the chasers", "text": "Behind the dollar's 59%, the Deutsche mark holds 15.8% and the ECU basket 8.5%. Europe's money is already #2, just split up."},
    {"t": 1998.6, "title": "Euro inherits #2", "text": "The euro launches in 1999 at 17.9%, taking over the mark, franc, guilder and ECU slots in one stroke."},
    {"t": 1999, "title": "Dollar peaks at 71%", "text": "The dollar's share tops out at 71.0% at the end of 1999, the highest share anywhere in this series."},
    {"t": 2005.5, "title": "Pound passes the yen", "text": "Sterling climbs to 5.3% as yen holdings shrink, taking third place in 2006 for about a decade."},
    {"t": 2009, "title": "Euro high-water mark", "text": "The euro peaks at 24.1% in 2009. The eurozone debt crisis follows, and its share settles back near 20%."},
    {"t": 2016, "title": "Renminbi enters", "text": "China's currency joins the IMF's SDR basket in Oct 2016 and is reported from Q4: 1.0%, peaking at 2.9% in 2021."},
    {"t": 2024.5, "title": "'Other' passes the yen", "text": "By 2025 smaller currencies like the won and Nordic krona add up to 6.1%, overtaking the yen for third place."},
    {"t": 2025, "title": "Dollar at a 30-year low", "text": "The dollar ends 2025 at 56.8% of allocated reserves, the lowest in this series, yet still nearly 3x the euro."}
  ]
