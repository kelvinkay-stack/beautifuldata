  "milestones": [
    {"t": 1950, "title": "Tuberculosis still in the top 10", "text": "About 34,000 Americans die of TB in 1950. With antibiotics it falls out of the top 10 within five years."},
    {"t": 1968, "title": "Infant deaths decline", "text": "Deaths from conditions of early infancy fall from about 67,000 in 1960 to 44,000 in 1968, and keep falling."},
    {"t": 1979, "title": "New coding, new No. 5", "text": "Under ICD-9, chronic obstructive lung disease is counted more broadly and becomes the 5th leading cause."},
    {"t": 1995, "title": "HIV deaths peak", "text": "HIV kills 43,115 people in 1995, the 8th leading cause. Combination antiretroviral therapy cuts deaths by more than 60% within three years."},
    {"t": 1999, "title": "Alzheimer's enters the top 10", "text": "The switch to ICD-10 classifies more dementia deaths as Alzheimer's disease; it ranks 8th with about 44,500 deaths."},
    {"t": 2016, "title": "Injuries rise to No. 3", "text": "Unintentional injuries, driven by the opioid overdose epidemic, pass chronic lower respiratory disease for 3rd place."},
    {"t": 2020, "title": "COVID-19 becomes No. 3", "text": "COVID-19 is recorded as the underlying cause of about 351,000 deaths in 2020, behind only heart disease and cancer."},
    {"t": 2023, "title": "COVID-19 falls to 10th", "text": "Deaths from COVID-19 drop 73% from 2022 to about 50,000; total US deaths fall back toward pre-pandemic levels."}
