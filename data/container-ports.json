 "milestones": [
  {
   "t": 1980,
   "title": "The Atlantic era",
   "text": "New York-New Jersey (1.95M TEU) and Rotterdam (1.90M) lead the container age, with Hong Kong and Kobe close behind."
  },
  {
   "t": 1987,
   "title": "Hong Kong takes the lead",
   "text": "Feeding southern China's factories, Hong Kong overtakes Rotterdam to become the world's busiest container port."
  },
  {
   "t": 1990,
   "title": "Hong Kong vs Singapore",
   "text": "Both pass 5M TEU. The two hubs trade the No. 1 spot for the next 20 years, with Singapore ahead in 1990-91 and 1998."
  },
  {
   "t": 1995,
   "title": "Kobe earthquake",
   "text": "The January 1995 Great Hanshin earthquake halves Kobe's throughput. The port, 4th in the world in 1980, never regains its rank."
  },
  {
   "t": 2005,
   "title": "Singapore on top",
   "text": "Singapore passes Hong Kong in 2005 and holds No. 1 through 2009, while Shanghai and Shenzhen close in fast."
  },
  {
   "t": 2010,
   "title": "Shanghai becomes No. 1",
   "text": "Shanghai handles 29.1M TEU in 2010, edging Singapore's 28.4M. It has been the world's busiest container port ever since."
  },
  {
   "t": 2018,
   "title": "Ningbo-Zhoushan reaches No. 3",
   "text": "Ningbo-Zhoushan passes Shenzhen for third place. Seven of the world's ten busiest container ports are now Chinese, Hong Kong included."
  },
  {
   "t": 2024,
   "title": "Hong Kong falls out of the top 10",
   "text": "Once No. 1, Hong Kong slides to 13.7M TEU in 2024 as cargo shifts to Shenzhen and other mainland ports."
  }
