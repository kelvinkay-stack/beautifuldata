 "milestones": [
  {
   "t": 1990,
   "title": "GM's long reign",
   "text": "General Motors has been the world's biggest carmaker since 1931, selling about 7.5 million vehicles a year, well clear of Ford."
  },
  {
   "t": 2007,
   "title": "A photo finish",
   "text": "GM tops 2007 by roughly 3,000 vehicles out of 9.37 million, the narrowest margin of its reign, as Toyota draws level."
  },
  {
   "t": 2008,
   "title": "Toyota ends GM's 77-year reign",
   "text": "As the financial crisis hits Detroit, Toyota sells 8.97M vehicles to GM's 8.36M and becomes the world's largest automaker."
  },
  {
   "t": 2011,
   "title": "Earthquake hands GM the lead",
   "text": "Japan's March 2011 earthquake and Thai floods cripple Toyota's supply chain; a post-bankruptcy GM briefly retakes No. 1."
  },
  {
   "t": 2016,
   "title": "Volkswagen takes the crown",
   "text": "Despite the Dieselgate scandal, VW Group delivers 10.3M vehicles in 2016, edging Toyota. It stays No. 1 through 2019."
  },
  {
   "t": 2020,
   "title": "Toyota back on top",
   "text": "Toyota weathers the pandemic and chip shortage better than rivals, retaking No. 1 in 2020 - a lead it has widened since."
  },
  {
   "t": 2021,
   "title": "Stellantis is born",
   "text": "PSA and Fiat Chrysler merge in January 2021, creating Stellantis - 14 brands and over 6 million vehicles a year."
  },
  {
   "t": 2024,
   "title": "BYD's rocket ride",
   "text": "BYD sells 4.27M plug-in and electric cars in 2024, up from 0.43M in 2020, passing Honda, Nissan and Suzuki."
  }
 ]
}