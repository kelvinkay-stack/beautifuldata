  "milestones": [
    {"t": 1964, "title": "Brazil's crop collapses", "text": "Frost and drought cut Brazil's 1964/65 crop to 11M bags — still No. 1, but barely ahead of Colombia's 8.4M."},
    {"t": 1976, "title": "The Black Frost", "text": "The July 1975 frost wipes out Brazilian trees: its 1976/77 crop falls to 9.3M bags, level with Colombia."},
    {"t": 1989, "title": "Quota system collapses", "text": "The International Coffee Agreement's export quotas end in 1989, unleashing new growers and a price slump."},
    {"t": 1999, "title": "Vietnam passes Colombia", "text": "Vietnam's robusta boom hits 11M bags in 1999/2000, passing Colombia (9.5M) for No. 2 — a spot it has held every year since but 2002/03."},
    {"t": 2008, "title": "Indonesia edges Colombia", "text": "Leaf rust cuts Colombia's harvest; Indonesia moves to No. 3 as Colombia slips to its lowest output in decades."},
    {"t": 2020, "title": "Brazil's record crop", "text": "Brazil harvests nearly 70M bags in 2020/21 — more than Vietnam, Colombia, Indonesia and Ethiopia combined."},
