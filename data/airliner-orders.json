 "milestones": [
  {
   "t": 1958.85,
   "title": "The jet age begins",
   "text": "Pan Am takes its first Boeing 707 in October 1958. Britain's Comet flew first, but the 707 and DC-8 make jet travel mainstream."
  },
  {
   "t": 1971.7,
   "title": "727 passes the 707",
   "text": "The three-engined 727 overtakes the 707 as the most-delivered jetliner. It ends production in 1984 at 1,831 aircraft."
  },
  {
   "t": 1990.2,
   "title": "737 becomes the best-seller",
   "text": "Revived by the CFM56-powered 737 Classic, the 737 passes the 727's 1,831 deliveries. It will hold the record for 35 years."
  },
  {
   "t": 2005.5,
   "title": "A320 family moves into 2nd",
   "text": "Airbus's fly-by-wire narrowbody overtakes the DC-9/MD-80 line, setting up a two-horse race with the 737."
  },
  {
   "t": 2019.1,
   "title": "777 overtakes the 747",
   "text": "The big twin passes the Queen of the Skies in total deliveries as airlines abandon four-engine jets. The last 747 is delivered in 2023."
  },
  {
   "t": 2019.25,
   "title": "737 MAX grounded",
   "text": "After two fatal crashes the MAX is grounded worldwide from March 2019 to late 2020. 737 deliveries fall from 580 in 2018 to 43 in 2020."
  },
  {
   "t": 2025.77,
   "title": "A320 passes the 737",
   "text": "On 6 October 2025 an A320neo for Flynas makes the A320 family the most-delivered jetliner ever, ending the 737's 35-year reign."
