  "milestones": [
    {"t": 1980, "title": "Japan's office is already No. 1", "text": "The JPO receives about 191,000 applications, nearly twice the USPTO's 104,000. Japan has led the world since 1968."},
    {"t": 1985, "title": "China opens for patents", "text": "China's first Patent Law takes effect on 1 April 1985; its office takes about 8,600 applications that year."},
    {"t": 2001, "title": "Japan peaks", "text": "JPO filings top out at about 439,000 in 2001 and then slide for two decades as Japanese firms file fewer, better-targeted patents."},
    {"t": 2006, "title": "USPTO overtakes the JPO", "text": "US filings reach about 426,000 against 409,000 in Japan, ending a 38-year Japanese lead."},
    {"t": 2010, "title": "China passes Japan", "text": "China's office receives about 391,000 applications to the JPO's 345,000, moving into second place."},
    {"t": 2011, "title": "China becomes No. 1", "text": "China's office receives about 526,000 applications to the USPTO's 504,000, and it has led the world every year since."},
    {"t": 2016, "title": "Over 1.3 million in China", "text": "China's filings pass 1.3 million, more than the US, Japanese, Korean and European offices combined."},
    {"t": 2024, "title": "India breaks 100,000", "text": "India's office tops 100,000 applications for the first time, up from about 43,000 in 2014. It passed Germany's DPMA in 2021."}
  ]
}
