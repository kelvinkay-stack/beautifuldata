  "milestones": [
    {"t": 1996, "title": "Losec dethrones Zantac", "text": "Astra's acid blocker overtakes Glaxo's ulcer drug as the world's top seller, with roughly $3.7B in sales."},
    {"t": 2001, "title": "Lipitor takes No. 1", "text": "Pfizer's statin passes Losec with about $6.5B and holds the crown for a decade as cholesterol pills become a mass market."},
    {"t": 2006, "title": "Lipitor peaks at $12.9B", "text": "Pfizer's statin hits its high point. US generics arrive in November 2011 and sales collapse within a year."},
    {"t": 2012, "title": "Humira becomes No. 1", "text": "AbbVie's injected antibody takes the crown at $9.3B as Lipitor goes generic, and it stays on top through 2020."},
    {"t": 2015, "title": "The hepatitis C cure", "text": "Gilead's Harvoni, about $94,500 a course, hits $13.9B and comes within $150M of toppling Humira."},
    {"t": 2021, "title": "Comirnaty smashes records", "text": "Pfizer books $36.8B for its COVID-19 vaccine, a record for any drug, then tops it with $37.8B in 2022."},
    {"t": 2023, "title": "Keytruda takes the crown", "text": "Merck's cancer immunotherapy becomes No. 1 at $25.0B as COVID sales fade and Humira faces biosimilars."},
