  "milestones": [
    {"t": 1978, "title": "8-track peaks", "text": "The 8-track hits $948M in 1978, second only to the LP — then collapses to almost nothing within four years."},
    {"t": 1983, "title": "Cassette passes the LP", "text": "Walkman-era tapes overtake vinyl albums: $1.81B to $1.69B. The LP will never lead again — not until a 2020s comeback."},
    {"t": 1990.6, "title": "CD overtakes the cassette", "text": "Neck and neck in 1990, the CD pulls clear in 1991 ($4.3B vs $3.0B) and becomes the most lucrative format ever sold."},
    {"t": 2000, "title": "Peak CD", "text": "CD revenue tops out at $13.2B in 2000; Napster launched the year before. Within a decade CD sales fall by three quarters."},
    {"t": 2007, "title": "Ringtone boom", "text": "Master ringtones bring in $1.06B in 2007 — briefly outearning both download albums and subscriptions."},
    {"t": 2015.6, "title": "Streaming takes #1", "text": "Paid subscriptions ($2.5B) overtake the CD ($1.1B) in 2016 and never look back, passing $11B by 2024."},
    {"t": 2019.6, "title": "Vinyl outsells CD", "text": "Vinyl LPs ($620M) beat CDs ($483M) in 2020 — the first time since 1986 — and pass $1.4B by 2024."}
