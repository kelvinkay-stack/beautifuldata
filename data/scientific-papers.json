  "milestones": [
    {"t": 1996, "title": "US output dwarfs everyone", "text": "The US publishes about 313,000 S&E articles, more than Japan, the UK and Germany combined. China manages 34,000."},
    {"t": 2003, "title": "China moves into third", "text": "Output nearly doubles in four years. China passes Germany in 2002 and the UK in 2003, trailing only the US and Japan."},
    {"t": 2004, "title": "China becomes No. 2", "text": "With about 121,000 articles China passes Japan, whose output has been flat for years and is about to start shrinking."},
    {"t": 2016, "title": "Dead heat at the top", "text": "China (430k) and the US (432k) are within 1%. NSF's 2018 Indicators, using its count at the time, declared China No. 1 for 2016."},
    {"t": 2017, "title": "China overtakes the United States", "text": "In NSF's current Scopus series China leads from 2017 (464k vs 435k) and keeps pulling away."},
    {"t": 2017.5, "title": "India climbs to third", "text": "India passes Japan and the UK in 2016 and Germany in 2017. Its output has grown sixfold since 1996."},
    {"t": 2019, "title": "Russia's publication push", "text": "Spurred by Project 5-100 and publication targets, Russian output more than doubles from 2013 to 2019, passing Italy, France and Korea."},
    {"t": 2023, "title": "China at twice the US", "text": "China publishes about 933,000 articles to 431,000 for the US. India (228k) is now more than double Germany."}
  ]
