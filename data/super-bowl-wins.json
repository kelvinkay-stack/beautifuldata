  "milestones": [
    {"t": 1968.1, "title": "Lombardi's Packers go 2-for-2", "text": "Green Bay win the first two Super Bowls over the AFL's Chiefs and Raiders; the trophy later takes Lombardi's name."},
    {"t": 1980.1, "title": "Steelers first to four", "text": "Pittsburgh beat the Rams in Super Bowl XIV for their fourth title in six seasons, the first franchise to reach four."},
    {"t": 1995.1, "title": "49ers first to five", "text": "Steve Young's six TD passes rout San Diego in Super Bowl XXIX, making San Francisco the first five-time champion."},
    {"t": 2002.1, "title": "The Patriots' first ring", "text": "Tom Brady's New England upset the Rams in Super Bowl XXXVI, the first of six titles in 18 seasons."},
    {"t": 2009.1, "title": "Steelers first to six", "text": "Santonio Holmes's late touchdown beats Arizona in Super Bowl XLIII, taking Pittsburgh clear of Dallas and SF on five."},
    {"t": 2019.1, "title": "Patriots tie Steelers at six", "text": "A 13-3 win over the Rams in Super Bowl LIII, the lowest-scoring Super Bowl, draws New England level with Pittsburgh."},
    {"t": 2024.1, "title": "Chiefs go back-to-back", "text": "Kansas City beat the 49ers in overtime in Super Bowl LVIII for a second straight title and their fourth overall."},
    {"t": 2026.1, "title": "Seahawks keep the tie intact", "text": "Seattle beat New England 29-13 in Super Bowl LX, denying the Patriots a record seventh title."}
  ]
