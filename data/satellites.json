  "milestones": [
    {"t": 1985, "title": "The Soviet fleet leads", "text": "The USSR runs about 170 working satellites to roughly 127 American ones, many of them short-lived reconnaissance and navigation craft."},
    {"t": 1993, "title": "US passes post-Soviet Russia", "text": "With launches collapsing after 1991, Russia's active fleet shrinks, and it falls to 81 by 2001."},
    {"t": 2014, "title": "China passes Russia", "text": "Beidou navigation, Yaogan reconnaissance and weather satellites push China into second place, about 108 to 107."},
    {"t": 2019.4, "title": "First Starlink batch", "text": "SpaceX launches its first batch of 60 Starlink satellites on 24 May 2019. By end-2020 its fleet outnumbers China and Russia combined."},
    {"t": 2020, "title": "SpaceX outnumbers the rest of the US", "text": "By year-end SpaceX operates about 867 satellites, more than every other US operator combined (about 829)."},
    {"t": 2021, "title": "OneWeb lifts the UK past China", "text": "UK-headquartered OneWeb's constellation briefly puts the UK ahead of China, about 464 satellites to 444."},
    {"t": 2022, "title": "Over half of all satellites", "text": "Starlink passes 50% of every active satellite in orbit, about 3,300 of 6,450."},
    {"t": 2026.8, "title": "Two-thirds Starlink", "text": "More than 10,500 Starlinks are working, about 67% of the world total. China, at about 1,290, is the largest national fleet after the US."}
  ]
